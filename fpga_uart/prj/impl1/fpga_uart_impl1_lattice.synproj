-a "MachXO3D"
-d LCMXO3D-9400HC
-t CABGA256
-s 5
-frequency 200
-optimization_goal Balanced
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-force_gsr Auto
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-mux_style Auto
-max_fanout 1000
-fsm_encoding_style Auto
-twr_paths 3
-fix_gated_clocks 1
-loop_limit 1950




-use_io_insertion 1
-resolve_mixed_drivers 0
-use_io_reg auto


-lpf 1
-p "/home/pnieves/fpga-workspace/fpga_uart/prj"
-ver "/home/pnieves/fpga-workspace/fpga_uart/src/fpga_uart_top.v"


-p "/home/pnieves/lscc/diamond/3.14/ispfpga/se5c00/data" "/home/pnieves/fpga-workspace/fpga_uart/prj/impl1" "/home/pnieves/fpga-workspace/fpga_uart/prj"

-ngd "fpga_uart_impl1.ngd"

