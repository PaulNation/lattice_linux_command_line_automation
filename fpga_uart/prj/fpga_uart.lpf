# top.lpf — Fixed pin constraints (CABGA400)
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "updwn"   SITE "C4" ;
IOBUF PORT "updwn" IO_TYPE=LVCMOS33 ;

LOCATE COMP "id"      SITE "C3" ;
IOBUF PORT "id" IO_TYPE=LVCMOS33 ;

LOCATE COMP "reset"   SITE "C2" ;
IOBUF PORT "reset" IO_TYPE=LVCMOS33 ;

LOCATE COMP "set"     SITE "D3" ;
IOBUF PORT "set" IO_TYPE=LVCMOS33 ;

LOCATE COMP "action"  SITE "D1" ;
IOBUF PORT "action" IO_TYPE=LVCMOS33 ;

# data[7:0]
LOCATE COMP "data[0]" SITE "E4" ;
IOBUF PORT "data[0]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[1]" SITE "E3" ;
IOBUF PORT "data[1]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[2]" SITE "E2" ;
IOBUF PORT "data[2]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[3]" SITE "D2" ;
IOBUF PORT "data[3]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[4]" SITE "F5" ;
IOBUF PORT "data[4]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[5]" SITE "G5" ;
IOBUF PORT "data[5]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[6]" SITE "F4" ;
IOBUF PORT "data[6]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "data[7]" SITE "F3" ;
IOBUF PORT "data[7]" IO_TYPE=LVCMOS33 ;

# count[7:0]
LOCATE COMP "count[0]" SITE "G3" ;
IOBUF PORT "count[0]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[1]" SITE "G4" ;
IOBUF PORT "count[1]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[2]" SITE "E2" ;
IOBUF PORT "count[2]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[3]" SITE "E1" ;
IOBUF PORT "count[3]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[4]" SITE "F2" ;
IOBUF PORT "count[4]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[5]" SITE "F1" ;
IOBUF PORT "count[5]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[6]" SITE "H3" ;
IOBUF PORT "count[6]" IO_TYPE=LVCMOS33 ;

LOCATE COMP "count[7]" SITE "H4" ;
IOBUF PORT "count[7]" IO_TYPE=LVCMOS33 ;

# TODO: assign sysclk (use a PCLK-capable pin like PL7A/PL7B if needed)
LOCATE COMP "sysclk" SITE "PL7A" ;
IOBUF PORT "sysclk" IO_TYPE=LVCMOS33 ;